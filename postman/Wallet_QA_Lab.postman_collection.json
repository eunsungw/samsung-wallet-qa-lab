      ]
    },
    {
      "name": "API-009 Invalid amount declines",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"invalid-{{requestId}}\",\n  \"amountCents\": 0,\n  \"category\": \"food\",\n  \"online\": true,\n  \"authValid\": true,\n  \"cardActive\": true,\n  \"deviceSupported\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid amount 422\", () => { pm.response.to.have.status(422); pm.expect(pm.response.json().code).to.eql(\"INVALID_INPUT\"); });"
            ]
          }

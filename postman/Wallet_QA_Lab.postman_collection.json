            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"auth-{{requestId}}\",\n  \"amountCents\": 1001,\n  \"category\": \"food\",\n  \"online\": true,\n  \"authValid\": false,\n  \"cardActive\": true,\n  \"deviceSupported\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",

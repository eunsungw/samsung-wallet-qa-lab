      ]
    },
    {
      "name": "API-010 Locked demo card declines",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/payments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"locked-{{requestId}}\",\n  \"amountCents\": 1001,\n  \"category\": \"food\",\n  \"online\": true,\n  \"authValid\": true,\n  \"cardActive\": false,\n  \"deviceSupported\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Card locked 423\", () => { pm.response.to.have.status(423); pm.expect(pm.response.json().code).to.eql(\"CARD_LOCKED\"); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4300/api/mock"
    }
  ]
}
